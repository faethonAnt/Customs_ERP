@model CustomsERP.Core.Document;

<div class="page-header">
    <h1>Update Document</h1>
</div>

<div class="form-card form-card-wide">
    <form method="post" asp-action="Update" asp-route-id="@Model.Id">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id"/>
        <input type="hidden" asp-for="ShipmentId"/>
        <input type="hidden" asp-for="CreatedOn"/>

        <table class="table align-middle">
            <thead>
            <tr>
                <th>Name</th>
                <th>Code</th>
                <th>File Path</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td><input asp-for="Name" class="form-control"/></td>
                <td><input asp-for="Code" class="form-control"/></td>
                <td><input asp-for="FilePath" class="form-control"/></td>
            </tr>
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" asp-route-shipmentId="@Model.ShipmentId" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
