@model CustomsERP.Web.ViewModels.DocumentIndexViewModel

<div class="page-header">
    <h1>Documents</h1>
    <a class="btn btn-primary" asp-controller="Document" asp-action="Create" asp-route-shipmentId="@Model.Shipment.Id">+ Add Document</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
    <tr>
        <th>Name</th>
        <th>Code</th>
        <th>Date</th>
        <th>File Path</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var doc in Model.Documents)
    {
        <tr>
            <td>@doc.Name</td>
            <td>@doc.Code</td>
            <td>@doc.CreatedOn</td>
            <td>@doc.FilePath</td>
            <td class="text-end table-actions">
                <a class="btn-icon btn-icon-edit" asp-controller="Document" asp-action="Update" asp-route-id="@doc.Id" title="Edit">✎</a>
                <a class="btn-icon btn-icon-delete" asp-controller="Document" asp-action="Delete" asp-route-id="@doc.Id" title="Delete">❌</a>
            </td>
        </tr>
    }
    </tbody>
</table>
