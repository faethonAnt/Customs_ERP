@model CustomsERP.Core.Document;

<div class="page-header">
    <h1>New Document</h1>
</div>

<div class="form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="ShipmentId"/>

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input asp-for="Name" class="form-control"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Code</label>
            <input asp-for="Code" class="form-control"/>
        </div>
        <div class="mb-3">
            <label class="form-label">File Path</label>
            <input asp-for="FilePath" class="form-control"/>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" asp-route-shipmentId="@Model.ShipmentId" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
