@model CustomsERP.Core.Document;

<div class="page-header">
    <h1>Delete Document</h1>
</div>

<div class="form-card">
    <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
    <form method="post" asp-controller="Document" asp-action="DeleteConfirmed" asp-route-id="@Model.Id">
        <button type="submit" class="btn btn-danger">Yes, delete</button>
        <a asp-action="Index" asp-route-shipmentId="@Model.ShipmentId" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
