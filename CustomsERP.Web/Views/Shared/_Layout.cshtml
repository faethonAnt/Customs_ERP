<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CustomsERP</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CustomsERP.Web.styles.css" asp-append-version="true" />
</head>
<body>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<div class="app-shell">
    <aside class="app-sidebar">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="brand-mark"><i class="bi bi-anchor"></i></span>
            <span class="brand-text">
                <span class="brand-name">CUSTOMSERP</span>
                <span class="brand-sub">ERP</span>
            </span>
        </a>

        <nav class="sidebar-nav">
            <a class="sidebar-link @(currentController == "Shipment" ? "active" : "")" asp-controller="Shipment" asp-action="Index">
                Shipments
            </a>
            <a class="sidebar-link @(currentController == "Exporter" ? "active" : "")" asp-controller="Exporter" asp-action="Index">
                Exporters
            </a>
            <a class="sidebar-link @(currentController == "Receiver" ? "active" : "")" asp-controller="Receiver" asp-action="Index">
                Receivers
            </a>
            <a class="sidebar-link @(currentController == "Product" ? "active" : "")" asp-controller="Product" asp-action="Index">
                Products
            </a>
            <a class="sidebar-link @(currentController == "Warehouse" ? "active" : "")" asp-controller="Warehouse" asp-action="Index">
                Warehouses
            </a>
            <a class="sidebar-link @(currentController == "Port" ? "active" : "")" asp-controller="Port" asp-action="Index">
                Ports
            </a>
            <a class="sidebar-link @(currentController == "ShippingCompany" ? "active" : "")" asp-controller="ShippingCompany" asp-action="Index">
                Shipping Companies
            </a>
        </nav>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <div class="breadcrumb-trail">
                <span class="breadcrumb-root">CustomsERP</span>
                <span class="breadcrumb-sep">/</span>
                <span class="breadcrumb-current">@ViewData["Title"]</span>
            </div>
        </header>

        <main role="main" class="app-content">
            @RenderBody()
        </main>

        <footer class="app-footer">
            &copy; 2026 CustomsERP &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
