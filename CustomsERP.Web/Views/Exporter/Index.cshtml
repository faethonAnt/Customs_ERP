@model List<CustomsERP.Core.Exporter>

<div class="page-header">
    <h1>Exporters</h1>
    <a class="btn btn-primary" asp-controller="Exporter" asp-action="Create">+ New Exporter</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
    <tr>
        <th>Eori</th>
        <th>Name</th>
        <th>Address</th>
        <th>City</th>
        <th>Zip Code</th>
        <th>Country</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var exporter in Model)
    {
        <tr>
            <td>@exporter.Eori</td>
            <td>@exporter.Name</td>
            <td>@exporter.Address</td>
            <td>@exporter.City</td>
            <td>@exporter.ZipCode</td>
            <td>@exporter.CountryCode</td>
            <td class="text-end table-actions">
                <a class="btn-icon btn-icon-edit" asp-controller="Exporter" asp-action="Update" asp-route-id="@exporter.Id" title="Edit">✎</a>
                <a class="btn-icon btn-icon-delete" asp-controller="Exporter" asp-action="Delete" asp-route-id="@exporter.Id" title="Delete">❌</a>
            </td>
        </tr>
    }
    </tbody>
</table>
