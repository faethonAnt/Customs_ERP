    <p>Manage shipments, exporters, and customs documentation in one place.</p>
</div>

<div class="module-grid">
    <a class="module-card" asp-controller="Product" asp-action="Index">Products</a>
    <a class="module-card" asp-controller="Receiver" asp-action="Index">Receiver</a>
    <a class="module-card" asp-controller="Shipment" asp-action="Index">Shipment</a>
    <a class="module-card" asp-controller="Exporter" asp-action="Index">Exporter</a>
    <a class="module-card" asp-controller="Warehouse" asp-action="Index">Warehouse</a>
    <a class="module-card" asp-controller="Port" asp-action="Index">Ports</a>
</div>
