@model List<CustomsERP.Core.ShippingCompany>

<div class="page-header">
    <h1>Shipping Companies</h1>
    <a class="btn btn-primary" asp-controller="ShippingCompany" asp-action="Create">+ New Shipping Company</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
    <tr>
        <th>Name</th>
        <th>Address</th>
        <th>City</th>
        <th>Bank Details</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var shippingCompany in Model)
    {
        <tr>
            <td>@shippingCompany.Name</td>
            <td>@shippingCompany.Address</td>
            <td>@shippingCompany.City</td>
            <td>@shippingCompany.BankDetails</td>
            <td class="text-end table-actions">
                <a class="btn-icon btn-icon-edit" asp-controller="ShippingCompany" asp-action="Update" asp-route-id="@shippingCompany.Id" title="Edit">✎</a>
                <a class="btn-icon btn-icon-delete" asp-controller="ShippingCompany" asp-action="Delete" asp-route-id="@shippingCompany.Id" title="Delete">❌</a>
            </td>
        </tr>
    }
    </tbody>
</table>
