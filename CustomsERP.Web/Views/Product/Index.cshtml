@model List<CustomsERP.Core.Product>

<div class="page-header">
    <h1>Products</h1>
    <a class="btn btn-primary" asp-controller="Product" asp-action="Create">+ New Product</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
    <tr>
        <th>Hs Code</th>
        <th>Name</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.HsCode</td>
            <td>@product.Name</td>
            <td class="text-end table-actions">
                <a class="btn-icon btn-icon-edit" asp-controller="Product" asp-action="Update" asp-route-id="@product.Id" title="Edit">✎</a>
                <a class="btn-icon btn-icon-delete" asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id" title="Delete">❌</a>
            </td>
        </tr>
    }
    </tbody>
</table>
