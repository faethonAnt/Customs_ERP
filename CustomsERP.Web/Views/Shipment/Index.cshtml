@model CustomsERP.Web.ViewModels.ShipmentFilterViewModel

<h1>Shipments</h1>
<form method="get">
    <select asp-for="ExporterId" asp-items="Model.Exporters">
        <option value="">All Exporters</option>
    </select>

    <select asp-for="ProductId" asp-items="Model.Products">
        <option value="">All Products</option>
    </select>

    <input asp-for="DateFrom" type="date" />
    <input asp-for="DateTo" type="date" />

    <button type="submit">Filter</button>
</form>
<table class="table">
    <thead>
    <tr>
        <th>MRN</th>
        <th>Exporter</th>
        <th>Date</th>
		<th>Files</th>
        <th>Edit</th>
        <th>Delete</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var shipment in Model.Shipments)
    {
        <tr>
            <td>@shipment.MRN</td>
            <td>@shipment.Exporter.Name</td>
            <td>@shipment.DateCreated</td>
														<!-- ShipmentId is used because the route is  -->
			<td><a asp-controller="Document" asp-action="Index" asp-route-ShipmentId="@shipment.Id">📂</a></td>
            <td><a asp-controller="Shipment" asp-action="Update" asp-route-id="@shipment.Id">✎</a></td>
            <td><a asp-controller="Shipment" asp-action="Delete" asp-route-id="@shipment.Id">❌</a></td>
        </tr>
    }
    </tbody>
</table>

<a asp-controller="Shipment" asp-action="Create">Create New Shipment</a>