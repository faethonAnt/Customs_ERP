@model CustomsERP.Web.ViewModels.ShipmentFilterViewModel

<div class="page-header">
    <h1>Shipments</h1>
    <a class="btn btn-primary" asp-controller="Shipment" asp-action="Create">+ New Shipment</a>
</div>

<form method="get" class="d-flex flex-wrap gap-2 align-items-end mb-3">
    <select asp-for="ExporterId" asp-items="Model.Exporters" class="form-select">
        <option value="">All Exporters</option>
    </select>

    <select asp-for="ProductId" asp-items="Model.Products" class="form-select">
        <option value="">All Products</option>
    </select>

    <input asp-for="DateFrom" type="date" class="form-control" />
    <input asp-for="DateTo" type="date" class="form-control" />

    <button type="submit" class="btn btn-secondary">Filter</button>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
    <tr>
        <th>MRN</th>
        <th>Exporter</th>
        <th>Date</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var shipment in Model.Shipments)
    {
        <tr>
            <td>@shipment.MRN</td>
            <td>@shipment.Exporter?.Name</td>
            <td>@shipment.DateCreated</td>
            <!-- ShipmentId is used because the route is scoped to a specific shipment's documents -->
            <td class="text-end table-actions">
                <a class="btn-icon btn-icon-neutral" asp-controller="Document" asp-action="Index" asp-route-ShipmentId="@shipment.Id" title="Files">📂</a>
                <a class="btn-icon btn-icon-edit" asp-controller="Shipment" asp-action="Update" asp-route-id="@shipment.Id" title="Edit">✎</a>
                <a class="btn-icon btn-icon-delete" asp-controller="Shipment" asp-action="Delete" asp-route-id="@shipment.Id" title="Delete">❌</a>
            </td>
        </tr>
    }
    </tbody>
</table>
