@model List<CustomsERP.Core.Shipment>

<div class="page-header">
    <h1>Shipments</h1>
    <a class="btn btn-primary" asp-controller="Shipment" asp-action="Create">+ New Shipment</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
    <tr>
        <th>MRN</th>
        <th>Exporter</th>
        <th>Date</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var shipment in Model)
    {
        <tr>
            <td>@shipment.MRN</td>
            <td>@shipment.Exporter?.Name</td>
            <td>@shipment.DateCreated</td>
            <!-- ShipmentId is used because the route is scoped to a specific shipment's documents -->
            <td class="text-end table-actions">
                <a class="btn-icon btn-icon-neutral" asp-controller="Document" asp-action="Index" asp-route-ShipmentId="@shipment.Id" title="Files">📂</a>
                <a class="btn-icon btn-icon-edit" asp-controller="Shipment" asp-action="Update" asp-route-id="@shipment.Id" title="Edit">✎</a>
                <a class="btn-icon btn-icon-delete" asp-controller="Shipment" asp-action="Delete" asp-route-id="@shipment.Id" title="Delete">❌</a>
            </td>
        </tr>
    }
    </tbody>
</table>
