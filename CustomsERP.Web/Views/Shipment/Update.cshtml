@model CustomsERP.Web.ViewModels.ShipmentFormViewModel;

<div class="page-header">
    <h1>Update Shipment</h1>
</div>

<div class="form-card form-card-wide">
    <form method="post" asp-action="Update" asp-route-id="@Model.Shipment.Id">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Shipment.Id"/>

        <table class="table align-middle">
            <thead>
            <tr>
                <th>MRN</th>
                <th>Exporter</th>
                <th>Receiver</th>
                <th>Shipping Company</th>
                <th>Port</th>
                <th>Warehouse</th>
                <th>DV1</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td><input asp-for="Shipment.MRN" class="form-control"/></td>
                <td><select asp-for="Shipment.ExporterId" asp-items="Model.Exporters" class="form-select"></select></td>
                <td><select asp-for="Shipment.ReceiverId" asp-items="Model.Receivers" class="form-select"></select></td>
                <td><select asp-for="Shipment.ShippingCompanyId" asp-items="Model.ShippingCompanies" class="form-select"></select></td>
                <td><select asp-for="Shipment.PortId" asp-items="Model.Ports" class="form-select"></select></td>
                <td><select asp-for="Shipment.WarehouseId" asp-items="Model.Warehouses" class="form-select"></select></td>
                <td><input type="checkbox" asp-for="Shipment.Dv1Exists" class="form-check-input"/></td>
            </tr>
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
