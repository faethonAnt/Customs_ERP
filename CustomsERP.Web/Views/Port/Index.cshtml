@model List<CustomsERP.Core.Port>

<div class="page-header">
    <h1>Ports</h1>
    <a class="btn btn-primary" asp-controller="Port" asp-action="Create">+ New Port</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
    <tr>
        <th>Port Code</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var port in Model)
    {
        <tr>
            <td>@port.PortCode</td>
            <td class="text-end table-actions">
                <a class="btn-icon btn-icon-edit" asp-controller="Port" asp-action="Update" asp-route-id="@port.Id" title="Edit">✎</a>
                <a class="btn-icon btn-icon-delete" asp-controller="Port" asp-action="Delete" asp-route-id="@port.Id" title="Delete">❌</a>
            </td>
        </tr>
    }
    </tbody>
</table>
